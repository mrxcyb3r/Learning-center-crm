# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# APP_URL: The public URL where this applet is hosted (used to derive the
# Telegram webhook URL). Set this to the deployed Cloud Run / AI Studio domain.
APP_URL="MY_APP_URL"
VITE_GEMINI_API_KEY=

# Demo login credentials (demo environment only).
# These MUST match real Firebase Auth users provisioned explicitly in the
# Firebase Console (Authentication → Users) for project centerflow-1fa34,
# each with its canonical Firestore users/{uid} role document
# (role=admin / teacher / student) created via a trusted path.
# The browser client only signs in — it never provisions accounts or roles.
# If unset, the app falls back to the documented project demo defaults.
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_TEACHER_EMAIL=
# VITE_DEMO_TEACHER_PASSWORD=
# VITE_DEMO_STUDENT_EMAIL=
# VITE_DEMO_STUDENT_PASSWORD=

# Telegram Bot & Server Security Configuration
ADMIN_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
FIREBASE_SERVICE_ACCOUNT_PATH=
WEB_PORTAL_URL=
BOT_MODE=webhook

# TELEGRAM_BOT_TOKEN (SERVER-SIDE ONLY — never paste into frontend code)
# → Telegram BotFather token. Obtain by talking to @BotFather and creating a new bot.
#   Example: 123456789:AAHbCDeFGhIjKlMnOpQRsTuVWxYz

# TELEGRAM_ADMIN_CHAT_ID
# → The Telegram group/chat ID where admin notifications (new leads/questions)
#   should be delivered. Get your own chat ID by sending /start to @userinfobot
#   and noting the numeric ID. For a group, add the bot and use the group ID.

# TELEGRAM_WEBHOOK_SECRET
# → Secret token used to validate Telegram webhook requests (recommended for
#   production). Generate a random string and configure it BOTH here and in
#   BotFather's webhook settings. The server rejects webhooks whose
#   X-Telegram-Bot-Api-Secret-Token header does not match this value.

# TELEGRAM_BOT_USERNAME (optional)
# → e.g. renessans_lc_bot (without @). Displayed in the Admin Telegram panel.

# FIREBASE_SERVICE_ACCOUNT_PATH
# → Absolute path to a Firebase service-account JSON file for server-side
#   Firestore writes (used by the Telegram webhook to create leads/questions).
#   On Cloud Run, omit this and let the runtime default service-account
#   credentials (GOOGLE_APPLICATION_CREDENTIALS / metadata server) be used.

# PUBLIC_URL / APP_URL / WEB_PORTAL_URL
# → The deployed base URL. The webhook is registered at
#   <PUBLIC_URL>/api/telegram/webhook (see Admin → Telegram Bot → Webhook setup).

# BOT_MODE
# → 'webhook' (recommended for Cloud Run — HTTP-based, no long-running polling)
#   Polling is intentionally disabled for production Cloud Run deployments.

# ADMIN_API_SECRET (optional, legacy fallback)
# → Used only as a legacy header fallback for admin-only API routes that cannot
#   yet verify a Firebase ID token.