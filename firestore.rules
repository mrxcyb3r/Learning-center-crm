rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserRole() == 'student';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isAdminOrTeacher() {
      return isAdmin() || isSuperAdmin() || isTeacher();
    }

    function getTeacherUid() {
      return request.auth.uid;
    }

    // =========================================================================
    // USERS COLLECTION - Canonical role document
    // =========================================================================
    match /users/{userId} {
      // Allow read for authenticated users (to check their own role)
      // Admin/SuperAdmin can read all users
      allow read: if isSignedIn() && (isOwner(userId) || isAdminOrSuperAdmin());

      // Allow create ONLY for:
      // 1. SuperAdmin (server-side/Admin SDK) - they bypass rules
      // 2. Authenticated user creating their OWN document with role='guest' (default on first login)
      //    This is for first-time users who sign up - they get 'guest' until admin assigns role
      allow create: if isSignedIn() 
        && isOwner(userId) 
        && request.resource.data.role == 'guest'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      // Allow update for:
      // 1. SuperAdmin - full access
      // 2. Admin - can update teacher/student roles but NOT admin/superadmin
      // 3. User can update their own profile fields EXCEPT role, uid, email
      allow update: if isSignedIn() && (
        (isSuperAdmin()) ||
        (isAdmin() 
          && request.resource.data.role != 'admin' 
          && request.resource.data.role != 'superadmin'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        ) ||
        (isOwner(userId) 
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        )
      );

      // Allow delete only for SuperAdmin
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // PUBLIC LANDING DATA - Readable without auth
    // =========================================================================
    match /settings/landing_cms {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /settings/landing_page_content {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // PUBLIC FORMS - Create only (no read/update/delete for public)
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /questions/{questionId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // CORE ERP DATA - Admin/Teacher access based on role
    // =========================================================================

    // Students
    match /students/{studentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfStudent(studentId));
      allow write: if isAdminOrSuperAdmin();
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfGroup(groupId));
      allow write: if isAdminOrSuperAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfPayment(paymentId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfPayment(paymentId));
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAttendance(attendanceId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAttendance(attendanceId));
    }

    // Homework/Assignments (primary collection: homework)
    match /homework/{homeworkId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfHomework(homeworkId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfHomework(homeworkId));
    }

    // Legacy assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAssignment(assignmentId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAssignment(assignmentId));
    }

    match /homework_submissions/{submissionId} {
      allow read: if isAdminOrSuperAdmin() 
        || (isTeacher() && isTeacherOfSubmission(submissionId))
        || (isStudent() && isOwnSubmission(submissionId));
      allow create: if isSignedIn(); // Students can submit
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfSubmission(submissionId));
    }

    // Feed Posts
    match /feed_posts/{postId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfFeedPost(postId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfFeedPost(postId));
    }

    // Mock Scores
    match /mock_scores/{scoreId} {
      allow read: if isAdminOrSuperAdmin() 
        || (isTeacher() && isTeacherOfMockScore(scoreId)) 
        || (isStudent() && isOwnMockScore(scoreId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfMockScore(scoreId));
    }

    // =========================================================================
    // TEACHER-SPECIFIC COLLECTIONS
    // =========================================================================
    match /teacher_tasks/{taskId} {
      allow read, write: if isAdminOrSuperAdmin() || (isTeacher() && isOwnTeacherTask(taskId));
    }

    match /teacher_documents/{docId} {
      allow read, write: if isAdminOrSuperAdmin() || (isTeacher() && isOwnTeacherDocument(docId));
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid 
        || resource.data.recipientRole == getUserRole() 
        || resource.data.recipientRole == 'all'
      );
      allow write: if isAdminOrSuperAdmin() 
        || (isTeacher() && request.auth.uid == resource.data.senderId);
    }

    // =========================================================================
    // SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // TELEGRAM SESSIONS
    // =========================================================================
    match /telegram_sessions/{sessionId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.userId);
    }

    // =========================================================================
    // HELPER FUNCTIONS FOR TEACHER SCOPING
    // =========================================================================
    function isTeacherOfStudent(studentId) {
      let studentDoc = get(/databases/$(database)/documents/students/$(studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfGroup(groupId) {
      let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
      return groupDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfPayment(paymentId) {
      let paymentDoc = get(/databases/$(database)/documents/payments/$(paymentId));
      let studentDoc = get(/databases/$(database)/documents/students/$(paymentDoc.data.studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfAttendance(attendanceId) {
      let attendanceDoc = get(/databases/$(database)/documents/attendance/$(attendanceId));
      let groupDoc = get(/databases/$(database)/documents/groups/$(attendanceDoc.data.groupId));
      return groupDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfHomework(homeworkId) {
      let homeworkDoc = get(/databases/$(database)/documents/homework/$(homeworkId));
      return homeworkDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfAssignment(assignmentId) {
      let assignmentDoc = get(/databases/$(database)/documents/assignments/$(assignmentId));
      return assignmentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfSubmission(submissionId) {
      let submissionDoc = get(/databases/$(database)/documents/homework_submissions/$(submissionId));
      let homeworkDoc = get(/databases/$(database)/documents/homework/$(submissionDoc.data.assignmentId));
      return homeworkDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfFeedPost(postId) {
      let postDoc = get(/databases/$(database)/documents/feed_posts/$(postId));
      let teacherDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return postDoc.data.author == teacherDoc.data.displayName;
    }

    function isTeacherOfMockScore(scoreId) {
      let scoreDoc = get(/databases/$(database)/documents/mock_scores/$(scoreId));
      let studentDoc = get(/databases/$(database)/documents/students/$(scoreDoc.data.studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isOwnMockScore(scoreId) {
      let scoreDoc = get(/databases/$(database)/documents/mock_scores/$(scoreId));
      return scoreDoc.data.studentId == request.auth.uid;
    }

    function isOwnSubmission(submissionId) {
      let submissionDoc = get(/databases/$(database)/documents/homework_submissions/$(submissionId));
      return submissionDoc.data.studentId == request.auth.uid;
    }

    function isOwnTeacherTask(taskId) {
      let taskDoc = get(/databases/$(database)/documents/teacher_tasks/$(taskId));
      return taskDoc.data.teacherId == request.auth.uid;
    }

    function isOwnTeacherDocument(docId) {
      let doc = get(/databases/$(database)/documents/teacher_documents/$(docId));
      return doc.data.teacherId == request.auth.uid;
    }
  }
}