rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 📩 1. Inquiries Collection (Public landing submissions)
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.fullName is string &&
                       request.resource.data.fullName.size() <= 100 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isSignedIn();
    }

    // ⚙️ 2. Settings Collection
    match /settings/{settingId} {
      allow read: if true; // Public CMS & authenticated settings lookup
      allow write: if isSignedIn();
    }

    // 👤 3. Users Collection & Subcollections (Strict Owner Boundary)
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isOwner(userId));

      match /chats/{chatId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 🎓 4. Students Collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /mock_scores/{scoreId} {
        allow read, write: if isSignedIn();
      }
    }

    // 📲 5. Telegram Sessions
    match /telegram_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // 💳 6. Payments
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // 📅 7. Attendance
    match /attendance/{attendanceId} {
      allow read, write: if isSignedIn();
    }

    // 📚 8. Homework & Feed
    match /homework/{homeworkId} {
      allow read, write: if isSignedIn();
    }

    match /assignments/{assignmentId} {
      allow read, write: if isSignedIn();
    }

    match /homework_submissions/{subId} {
      allow read, write: if isSignedIn();
    }

    match /feed_posts/{postId} {
      allow read, write: if isSignedIn();
    }

    // 🏫 9. Groups
    match /groups/{groupId} {
      allow read, write: if isSignedIn();
    }

    // 🔔 10. Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
  }
}
