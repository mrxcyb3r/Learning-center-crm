rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserRole() == 'student';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isAdminOrTeacher() {
      return isAdmin() || isSuperAdmin() || isTeacher();
    }

    function getTeacherUid() {
      return request.auth.uid;
    }

    // =========================================================================
    // USERS COLLECTION - Canonical role document
    // =========================================================================
    match /users/{userId} {
      // Allow read for authenticated users (to check their own role)
      // Admin/SuperAdmin can read all users
      allow read: if isSignedIn() && (isOwner(userId) || isAdminOrSuperAdmin());

      // Allow create ONLY for:
      // 1. SuperAdmin (server-side/Admin SDK) - they bypass rules
      // 2. Authenticated user creating their OWN document with role='guest' (default on first login)
      //    This is for first-time users who sign up - they get 'guest' until admin assigns role
      // 3. One-time teacher invitation redemption: a newly registered teacher
      //    creating their OWN document with role='teacher', bound to a pending,
      //    unexpired invitation whose secret they prove knowledge of. The same
      //    transaction marks the invitation used (see teacher_invitations).
      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'guest'
          || isValidTeacherRedemption(request.resource.data)
        );

      // Allow update for:
      // 1. SuperAdmin - full access
      // 2. Admin - can update teacher/student roles but NOT admin/superadmin.
      //    Admin maintains the assignedGroupIds assignment index.
      // 3. User can update their own profile fields EXCEPT role, uid, email
      //    AND assignedGroupIds (the teacher-group assignment index is
      //    admin-maintained; owners can read it but never modify it).
      allow update: if isSignedIn() && (
        (isSuperAdmin()) ||
        (isAdmin()
          && request.resource.data.role != 'admin'
          && request.resource.data.role != 'superadmin'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        ) ||
        (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('assignedGroupIds', []) == resource.data.get('assignedGroupIds', [])
        )
      );

      // Allow delete only for SuperAdmin
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // PUBLIC LANDING DATA - Readable without auth
    // =========================================================================
    match /settings/landing_cms {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /settings/landing_page_content {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // PUBLIC FORMS - Create only (no read/update/delete for public)
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /questions/{questionId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // CORE ERP DATA - Admin/Teacher access based on role
    // =========================================================================

    // Students
    match /students/{studentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfStudent(studentId));
      allow write: if isAdminOrSuperAdmin();
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfGroup(groupId));
      allow write: if isAdminOrSuperAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfPayment(paymentId));
      allow create: if isAdminOrSuperAdmin()
        || (isTeacher() && request.resource.data.studentId is string
            && isTeacherOfStudent(request.resource.data.studentId));
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfPayment(paymentId));
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfInvoice(invoiceId));
      allow create: if isAdminOrSuperAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // Attendance
    // NOTE: create must not use the per-document helpers (the target doc does
    // not exist yet). Teacher create is allowed only when the attendance
    // record's own groupId points at a group owned by that teacher.
    match /attendance/{attendanceId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAttendance(attendanceId));
      allow create: if isAdminOrSuperAdmin() || isTeacherCreatingForOwnGroup();
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAttendance(attendanceId));
    }

    // Homework/Assignments (primary collection: homework)
    // NOTE: same create rationale — a teacher may create only records tagged
    // with their own UID in teacherId.
    match /homework/{homeworkId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfHomework(homeworkId));
      allow create: if isAdminOrSuperAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfHomework(homeworkId));
    }

    // Legacy assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAssignment(assignmentId));
      allow create: if isAdminOrSuperAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfAssignment(assignmentId));
    }

    match /homework_submissions/{submissionId} {
      allow read: if isAdminOrSuperAdmin() 
        || (isTeacher() && isTeacherOfSubmission(submissionId))
        || (isStudent() && isOwnSubmission(submissionId));
      allow create: if isSignedIn(); // Students can submit
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfSubmission(submissionId));
    }

    // Feed Posts
    match /feed_posts/{postId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfFeedPost(postId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfFeedPost(postId));
    }

    // Mock Scores
    match /mock_scores/{scoreId} {
      allow read: if isAdminOrSuperAdmin() 
        || (isTeacher() && isTeacherOfMockScore(scoreId)) 
        || (isStudent() && isOwnMockScore(scoreId));
      allow write: if isAdminOrSuperAdmin() || (isTeacher() && isTeacherOfMockScore(scoreId));
    }

    // =========================================================================
    // TEACHER-SPECIFIC COLLECTIONS
    // =========================================================================
    // NOTE: reads/creates use direct teacherId checks so teacher-filtered
    // list queries stay provable; updates/deletes keep per-document checks.
    // A teacher can only ever touch documents tagged with their own UID.
    match /teacher_tasks/{taskId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdminOrSuperAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isOwnTeacherTask(taskId));
    }

    match /teacher_documents/{docId} {
      allow read: if isAdminOrSuperAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdminOrSuperAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin() || (isTeacher() && isOwnTeacherDocument(docId));
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAdminOrSuperAdmin() || (isSignedIn() && (
        resource.data.recipientId == request.auth.uid
        || resource.data.recipientRole == getUserRole()
        || resource.data.recipientRole == 'all'
      ));
      // NOTE: create must check request.resource (resource is null on create).
      allow create: if isAdminOrSuperAdmin()
        || (isTeacher() && request.resource.data.senderId == request.auth.uid);
      allow update, delete: if isAdminOrSuperAdmin()
        || (isTeacher() && request.auth.uid == resource.data.senderId);
    }

    // =========================================================================
    // SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // ADMIN ERP COLLECTIONS (no public/teacher access by design)
    // =========================================================================
    match /expenses/{expenseId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /cms/{docId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /telegram_logs/{logId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /branches_config/{branchId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /rooms_config/{roomId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    match /staff_config/{staffId} {
      allow read, write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // TEACHER INVITATIONS - one-time onboarding capabilities
    // =========================================================================
    // Invitation document IDs are unguessable 256-bit capabilities. Single-doc
    // reads are public so the registration page can validate its own link;
    // listing is admin-only, so invitations cannot be enumerated.
    // The plaintext secret lives only in the invitation doc + the issued URL;
    // redemption is enforced here in rules (never UI-only).
    match /teacher_invitations/{invitationId} {
      allow get: if true;
      allow list: if isAdminOrSuperAdmin();
      allow create: if isAdminOrSuperAdmin();
      allow update: if isAdminOrSuperAdmin() || isValidRedemption();
      allow delete: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // TELEGRAM SESSIONS
    // =========================================================================
    // Deep-link linking sessions. Field convention is `userUid` (matches the
    // client linkers). Creation is owner-scoped to the signed-in CRM user and
    // must start as 'pending'; the server consumes the session via the Admin
    // SDK (bypasses rules) and marks it 'used' atomically (one-time use).
    // update/delete are admin-only so a leaked session cannot be tampered with.
    match /telegram_sessions/{sessionId} {
      allow read: if isSignedIn() && (isAdminOrSuperAdmin() || resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdminOrSuperAdmin();
      allow delete: if isSignedIn() && (isAdminOrSuperAdmin() || resource.data.userUid == request.auth.uid);
    }

    // =========================================================================
    // TELEGRAM WEBHOOK IDEMPOTENCY
    // =========================================================================
    // Written by the trusted server (Firebase Admin SDK, bypasses rules).
    // Client access is admin-only; keys are Telegram update_ids.
    match /telegram_updates/{updateId} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isAdminOrSuperAdmin();
    }

    // =========================================================================
    // HELPER FUNCTIONS FOR TEACHER SCOPING
    // =========================================================================
    function isTeacherOfStudent(studentId) {
      let studentDoc = get(/databases/$(database)/documents/students/$(studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfGroup(groupId) {
      let groupDoc = get(/databases/$(database)/documents/groups/$(groupId));
      return groupDoc.data.teacherId == request.auth.uid;
    }

    // For attendance CREATE: the record does not exist yet, so ownership is
    // proven through the groupId carried in the new record itself.
    function isTeacherCreatingForOwnGroup() {
      return isTeacher()
        && request.resource.data.groupId is string
        && isTeacherOfGroup(request.resource.data.groupId);
    }

    // One-time teacher invitation redemption (users create, role='teacher').
    // The presenter proves knowledge of the invitation secret by echoing it;
    // the invitation must be pending and unexpired at commit time.
    function isPendingInvitation(invitationId, secret) {
      let inv = get(/databases/$(database)/documents/teacher_invitations/$(invitationId)).data;
      return inv.status == 'pending'
        && inv.expiresAt > request.time
        && inv.secret == secret;
    }

    function isValidTeacherRedemption(data) {
      return data.role == 'teacher'
        && data.get('invitationId', '') is string
        && data.get('invitationSecret', '') is string
        && isPendingInvitation(data.get('invitationId', ''), data.get('invitationSecret', ''));
    }

    // Invitation status may move pending -> used exactly once, by the teacher
    // completing registration. All identifying fields must remain unchanged;
    // only status/usedByUid/usedAt change, and expiry is re-checked.
    function isValidRedemption() {
      let cur = resource.data;
      let nxt = request.resource.data;
      return isSignedIn()
        && cur.status == 'pending'
        && cur.expiresAt > request.time
      && nxt.status == 'used'
      && nxt.usedByUid == request.auth.uid
      && nxt.usedAt is timestamp
        && nxt.secret == cur.secret
        && nxt.teacherEmail == cur.teacherEmail
        && nxt.teacherName == cur.teacherName
        && nxt.createdBy == cur.createdBy
        && nxt.createdAt == cur.createdAt
        && nxt.expiresAt == cur.expiresAt
        && nxt.role == 'teacher'
        && cur.role == 'teacher';
    }

    function isTeacherOfPayment(paymentId) {
      let paymentDoc = get(/databases/$(database)/documents/payments/$(paymentId));
      let studentDoc = get(/databases/$(database)/documents/students/$(paymentDoc.data.studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfInvoice(invoiceId) {
      let invoiceDoc = get(/databases/$(database)/documents/invoices/$(invoiceId));
      let studentDoc = get(/databases/$(database)/documents/students/$(invoiceDoc.data.studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfAttendance(attendanceId) {
      let attendanceDoc = get(/databases/$(database)/documents/attendance/$(attendanceId));
      let groupDoc = get(/databases/$(database)/documents/groups/$(attendanceDoc.data.groupId));
      return groupDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfHomework(homeworkId) {
      let homeworkDoc = get(/databases/$(database)/documents/homework/$(homeworkId));
      return homeworkDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfAssignment(assignmentId) {
      let assignmentDoc = get(/databases/$(database)/documents/assignments/$(assignmentId));
      return assignmentDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfSubmission(submissionId) {
      let submissionDoc = get(/databases/$(database)/documents/homework_submissions/$(submissionId));
      let homeworkDoc = get(/databases/$(database)/documents/homework/$(submissionDoc.data.assignmentId));
      return homeworkDoc.data.teacherId == request.auth.uid;
    }

    function isTeacherOfFeedPost(postId) {
      let postDoc = get(/databases/$(database)/documents/feed_posts/$(postId));
      let teacherDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return postDoc.data.author == teacherDoc.data.displayName;
    }

    function isTeacherOfMockScore(scoreId) {
      let scoreDoc = get(/databases/$(database)/documents/mock_scores/$(scoreId));
      let studentDoc = get(/databases/$(database)/documents/students/$(scoreDoc.data.studentId));
      return studentDoc.data.teacherId == request.auth.uid;
    }

    function isOwnMockScore(scoreId) {
      let scoreDoc = get(/databases/$(database)/documents/mock_scores/$(scoreId));
      return scoreDoc.data.studentId == request.auth.uid;
    }

    function isOwnSubmission(submissionId) {
      let submissionDoc = get(/databases/$(database)/documents/homework_submissions/$(submissionId));
      return submissionDoc.data.studentId == request.auth.uid;
    }

    function isOwnTeacherTask(taskId) {
      let taskDoc = get(/databases/$(database)/documents/teacher_tasks/$(taskId));
      return taskDoc.data.teacherId == request.auth.uid;
    }

    function isOwnTeacherDocument(docId) {
      let doc = get(/databases/$(database)/documents/teacher_documents/$(docId));
      return doc.data.teacherId == request.auth.uid;
    }
  }
}