rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // 📩 1. Inquiries Collection (Landing Page Lead Submissions)
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // ⚙️ 2. Settings Collection (Security PINs, Landing Page CMS Content)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 👤 3. Users Collection (Profiles & AI Chat)
    match /users/{userId} {
      allow read, write: if true;

      match /chats/{chatId} {
        allow read, write: if true;
      }
    }

    // 🎓 4. Students Collection
    match /students/{studentId} {
      allow read, write: if true;

      match /mock_scores/{scoreId} {
        allow read, write: if true;
      }
    }

    // 💳 5. Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 📅 6. Attendance Collection
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // 📚 7. Homework & Assignments Collection
    match /homework/{homeworkId} {
      allow read, write: if true;
    }

    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /homework_submissions/{subId} {
      allow read, write: if true;
    }

    match /feed_posts/{postId} {
      allow read, write: if true;
    }

    // 🏫 8. Groups Collection
    match /groups/{groupId} {
      allow read, write: if true;
    }

    // 🔔 9. Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
