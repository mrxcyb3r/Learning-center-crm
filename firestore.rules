rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 📩 1. Inquiries & Leads Collections (Public landing submissions & Admin pipeline)
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    // ⚙️ 2. Settings Collection (CMS & App Config)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 👤 3. Users Collection & Subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /chats/{chatId} {
        allow read, write: if true;
      }
    }

    // 🎓 4. Students Collection
    match /students/{studentId} {
      allow read, write: if true;

      match /mock_scores/{scoreId} {
        allow read, write: if true;
      }
    }

    // 📲 5. Telegram Sessions
    match /telegram_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 💳 6. Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 📅 7. Attendance
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // 📚 8. Homework, Assignments & Feed
    match /homework/{homeworkId} {
      allow read, write: if true;
    }

    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /homework_submissions/{subId} {
      allow read, write: if true;
    }

    match /feed_posts/{postId} {
      allow read, write: if true;
    }

    // 🏫 9. Groups
    match /groups/{groupId} {
      allow read, write: if true;
    }

    // 🔔 10. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}

